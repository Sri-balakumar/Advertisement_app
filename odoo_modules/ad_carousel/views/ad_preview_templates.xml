<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- In-Odoo live preview: the carousel shown inside a phone-sized device
         frame (app proportions) so it reads exactly like the app screen.
         Self-contained (inline CSS + vanilla JS); ads embedded as a data
         attribute (JSON), read client-side. Opened from Ad Carousel -> Live Preview. -->
    <template id="ad_preview_page" name="Ad Carousel Live Preview">
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Live Preview — Ad Carousel</title>
                <style>
                    * { box-sizing: border-box; }
                    body {
                        margin: 0; min-height: 100vh;
                        display: flex; flex-direction: column; align-items: center;
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                        background: radial-gradient(1100px 700px at 50% -10%, #21232c, #0e0f14 60%);
                        color: #e5e7eb;
                    }
                    .topbar {
                        width: 100%; max-width: 900px; display: flex; align-items: center;
                        justify-content: space-between; padding: 18px 22px;
                    }
                    .title { font-size: 18px; font-weight: 800; }
                    .title small { color: #9aa0ac; font-weight: 600; }
                    .refresh {
                        color: #c7c9d1; text-decoration: none; font-size: 13px; font-weight: 700;
                        border: 1px solid #33353f; padding: 8px 14px; border-radius: 999px;
                    }
                    .refresh:hover { background: #1b1d24; }
                    .stage {
                        flex: 1; display: flex; align-items: center; justify-content: center;
                        padding: 8px 16px 28px; width: 100%;
                    }
                    /* Phone device frame at app proportions. */
                    .phone {
                        position: relative; width: min(390px, 94vw);
                        aspect-ratio: 9 / 19.5; max-height: 92vh;
                        background: #000; border-radius: 44px; padding: 12px;
                        box-shadow: 0 30px 80px rgba(0,0,0,.6), 0 0 0 2px #2a2c35 inset;
                    }
                    .screen {
                        position: relative; width: 100%; height: 100%;
                        border-radius: 34px; overflow: hidden; background: #0b0b12;
                    }
                    .slide {
                        position: absolute; inset: 0; opacity: 0; transition: opacity .5s ease;
                        display: flex; align-items: center; justify-content: center; background: #0b0b12;
                    }
                    .slide.active { opacity: 1; }
                    .media { width: 100%; height: 100%; object-fit: cover; }
                    .qrcard {
                        position: absolute; left: 12px; right: 12px; bottom: 16px;
                        background: #fff; color: #111827; border-radius: 16px; padding: 10px;
                        display: flex; align-items: center; gap: 12px;
                        box-shadow: 0 8px 24px rgba(0,0,0,.35);
                    }
                    .qrcard img { width: 64px; height: 64px; border-radius: 8px; }
                    .qt { font-weight: 800; font-size: 14px; }
                    .qn { color: #6b7280; font-size: 12px; margin-top: 2px; }
                    .notch {
                        position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
                        width: 120px; height: 26px; background: #000;
                        border-radius: 0 0 16px 16px; z-index: 5;
                    }
                    .dots {
                        position: absolute; top: 16px; left: 0; right: 0;
                        display: flex; gap: 5px; justify-content: center; z-index: 6;
                    }
                    .dot { width: 6px; height: 6px; border-radius: 3px; background: rgba(255,255,255,.4); transition: width .3s; }
                    .dot.on { width: 18px; background: #fff; }
                    .empty {
                        position: absolute; inset: 0; display: none; flex-direction: column;
                        align-items: center; justify-content: center; color: #6b7280;
                        gap: 8px; text-align: center; padding: 24px;
                    }
                </style>
            </head>
            <body>
                <div class="topbar">
                    <div class="title">Live Preview
                        <small>· <t t-esc="ad_count"/> live <t t-esc="'ad' if ad_count == 1 else 'ads'"/></small>
                    </div>
                    <a class="refresh" href="/ad/preview">↻ Refresh</a>
                </div>
                <div class="stage">
                    <div class="phone">
                        <div class="notch"></div>
                        <div class="screen">
                            <div class="dots" id="dots"></div>
                            <div id="slides"></div>
                            <div class="empty" id="empty">
                                <div style="font-size:34px">📭</div>
                                <div>No live ads yet. Add one in Ad Carousel, then refresh.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="ads-data" t-att-data-ads="ads_json" hidden="hidden"></div>

                <script>
                    (function () {
                        var ADS = [];
                        try { ADS = JSON.parse(document.getElementById('ads-data').dataset.ads || '[]'); } catch (e) { ADS = []; }
                        var slides = document.getElementById('slides');
                        var dotsEl = document.getElementById('dots');
                        var DEFAULT = 4;
                        if (!ADS.length) { document.getElementById('empty').style.display = 'flex'; return; }

                        ADS.forEach(function (ad, i) {
                            var s = document.createElement('div');
                            s.className = 'slide' + (i === 0 ? ' active' : '');
                            var media;
                            if (ad.media_type === 'video' &amp;&amp; ad.video) {
                                media = document.createElement('video');
                                media.src = ad.video; media.muted = true; media.loop = true;
                                media.autoplay = true; media.className = 'media';
                                media.setAttribute('playsinline', '');
                            } else if (ad.image) {
                                media = document.createElement('img');
                                media.src = ad.image; media.className = 'media'; media.alt = ad.name || '';
                            } else {
                                media = document.createElement('div');
                            }
                            s.appendChild(media);
                            if (!ad.has_qr &amp;&amp; ad.qr) {
                                var card = document.createElement('div'); card.className = 'qrcard';
                                var q = document.createElement('img'); q.src = ad.qr;
                                var txt = document.createElement('div');
                                var qt = document.createElement('div'); qt.className = 'qt'; qt.textContent = 'Scan to open';
                                var qn = document.createElement('div'); qn.className = 'qn'; qn.textContent = ad.name || '';
                                txt.appendChild(qt); txt.appendChild(qn);
                                card.appendChild(q); card.appendChild(txt);
                                s.appendChild(card);
                            }
                            slides.appendChild(s);
                            var d = document.createElement('div');
                            d.className = 'dot' + (i === 0 ? ' on' : '');
                            dotsEl.appendChild(d);
                        });

                        var els = slides.querySelectorAll('.slide');
                        var dots = dotsEl.querySelectorAll('.dot');
                        var idx = 0;
                        function show(n) {
                            els[idx].classList.remove('active'); dots[idx].classList.remove('on');
                            var v0 = els[idx].querySelector('video'); if (v0) { try { v0.pause(); } catch (e) {} }
                            idx = n;
                            els[idx].classList.add('active'); dots[idx].classList.add('on');
                            var v1 = els[idx].querySelector('video'); if (v1) { try { v1.currentTime = 0; v1.play(); } catch (e) {} }
                        }
                        function schedule() {
                            if (ADS.length &lt; 2) return;
                            var secs = Number(ADS[idx] &amp;&amp; ADS[idx].scroll_seconds) || DEFAULT;
                            setTimeout(function () { show((idx + 1) % ADS.length); schedule(); }, Math.max(2, secs) * 1000);
                        }
                        var fv = els[0].querySelector('video'); if (fv) { try { fv.play(); } catch (e) {} }
                        schedule();
                    })();
                </script>
            </body>
        </html>
    </template>

</odoo>
