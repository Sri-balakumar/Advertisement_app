<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="app_banner_form_view" model="ir.ui.view">
        <field name="name">app.banner.form</field>
        <field name="model">app.banner</field>
        <field name="arch" type="xml">
            <form string="Banner">
                <header>
                    <button name="action_create_product_from_banner" type="object"
                            string="Create Product from Banner" class="oe_highlight"
                            icon="fa-magic" invisible="link_type != 'product' or product_id"/>
                    <button name="action_unarchive_banner" type="object"
                            string="Unarchive" class="oe_highlight"
                            invisible="active"/>
                    <button name="action_archive_banner" type="object"
                            string="Archive"
                            invisible="not active"/>
                    <button name="action_delete_banner" type="object"
                            string="Delete" class="btn-danger"
                            confirm="This permanently removes the banner from the carousel. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_scans" type="object"
                                class="oe_stat_button" icon="fa-qrcode">
                            <field name="scan_count" widget="statinfo" string="Scans"/>
                        </button>
                        <button name="action_view_enquiries" type="object"
                                class="oe_stat_button" icon="fa-envelope">
                            <field name="enquiry_count" widget="statinfo" string="Enquiries"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <!-- Guide the admin: warn until the chosen destination is
                         actually configured, else the QR shows a holding page. -->
                    <div class="alert alert-warning" role="alert"
                         invisible="(link_type == 'product' and product_id) or (link_type == 'url' and target_url) or (link_type == 'pdf' and brochure)">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        No destination set yet — scanning this QR shows an
                        "unavailable" page. Set the <b>On Scan Show</b> target
                        below (a product, a link, or a PDF).
                    </div>
                    <!-- 3:1 image preview matches the mobile-app Home
                         carousel exactly (CarouselPagination.js renders
                         each banner card at aspectRatio: 3). Click the
                         image to upload / replace; this is the native
                         Odoo Replace UX. -->
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'size': [900, 300], 'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name" string="Banner Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Summer Sale"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="link_type" widget="radio"
                                   options="{'horizontal': True}"/>
                            <field name="product_id"
                                   options="{'no_create_edit': True}"
                                   invisible="link_type != 'product'"/>
                            <field name="target_url"
                                   placeholder="e.g. https://alphalize.com"
                                   invisible="link_type != 'url'"/>
                            <field name="brochure" widget="binary"
                                   filename="brochure_filename"
                                   invisible="link_type not in ('pdf', 'product')"/>
                            <field name="brochure_filename" invisible="1"/>
                            <field name="access_code"
                                   placeholder="e.g. summer-sale"/>
                            <field name="redirect_url" widget="CopyClipboardChar"
                                   readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group string="QR Code">
                            <field name="qr_image" widget="image" nolabel="1"
                                   options="{'size': [180, 180]}"/>
                            <button name="action_download_qr" type="object"
                                    string="Download QR" class="btn-secondary"
                                    icon="fa-download" invisible="not id"/>
                            <button name="action_open_link" type="object"
                                    string="Open destination" class="btn-link"
                                    icon="fa-external-link"
                                    invisible="not id or (link_type == 'product' and not product_id)"/>
                        </group>
                    </group>
                    <!-- Reassure: switching destination / swapping link or PDF
                         does NOT change the QR (it only encodes the short code). -->
                    <div class="text-muted small mb-2">
                        <i class="fa fa-refresh me-1"/>
                        You can change <b>On Scan Show</b> (link ↔ PDF ↔ product) or
                        swap the link / PDF anytime — the QR stays the same, no reprint.
                    </div>
                    <!-- Editing the short code DOES change the QR image — any
                         codes already printed / displayed will stop working. -->
                    <div class="alert alert-info" role="alert" invisible="not id">
                        <i class="fa fa-info-circle me-1"/>
                        The short code is part of the QR. If you change it, any
                        <b>already-printed QR codes stop working</b> — re-download
                        and reprint the QR after editing.
                    </div>
                    <notebook>
                        <page string="Gallery" name="gallery">
                            <field name="gallery_image_ids">
                                <kanban>
                                    <field name="sequence" widget="handle"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="d-flex align-items-center">
                                                <field name="image_128" widget="image"
                                                       class="me-2"
                                                       options="{'size': [80, 80]}"/>
                                                <field name="name" placeholder="Caption"/>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                                <form string="Gallery Image">
                                    <group>
                                        <field name="image_1920" widget="image"/>
                                        <field name="name"/>
                                        <field name="sequence"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Contact" name="contact">
                            <div class="text-muted mb-2">
                                Shown as WhatsApp / Call buttons on the
                                <b>Product Page</b> landing.
                            </div>
                            <group>
                                <field name="cta_phone"
                                       placeholder="e.g. +1 555 123 4567"/>
                            </group>
                        </page>
                    </notebook>
                    <field name="image_filename" invisible="1"/>
                    <field name="sequence" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="app_banner_list_view" model="ir.ui.view">
        <field name="name">app.banner.list</field>
        <field name="model">app.banner</field>
        <field name="arch" type="xml">
            <list string="Banners" multi_edit="1">
                <field name="image" widget="image" class="oe_avatar"
                       options="{'size': [120, 40]}"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="create_date" optional="hide"/>
                <field name="write_date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="app_banner_kanban_view" model="ir.ui.view">
        <field name="name">app.banner.kanban</field>
        <field name="model">app.banner</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="active"/>
                <field name="write_date"/>
                <templates>
                    <!-- Odoo 19 kanban: template name MUST be "card"
                         (legacy "kanban-box" was dropped) and the
                         kanban_image() helper was REMOVED — calling it
                         throws "ctx.kanban_image is not a function".
                         Use the public /web/image/<model>/<id>/<field>
                         endpoint instead, with ?unique=<write_date> to
                         bust the browser cache when admins replace the
                         image. -->
                    <t t-name="card">
                        <img t-attf-src="/web/image/app.banner/{{record.id.raw_value}}/image?unique={{record.write_date.raw_value}}"
                             alt="Banner" class="w-100 rounded"
                             style="aspect-ratio: 3 / 1; object-fit: cover;"/>
                        <div class="mt-2 d-flex align-items-center">
                            <strong class="me-2">
                                <field name="name"/>
                            </strong>
                            <span t-if="!record.active.raw_value"
                                  class="badge text-bg-secondary">Archived</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="app_banner_search_view" model="ir.ui.view">
        <field name="name">app.banner.search</field>
        <field name="model">app.banner</field>
        <field name="arch" type="xml">
            <search string="Search Banners">
                <field name="name"/>
                <filter string="Active" name="active"
                        domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="app_banner_action" model="ir.actions.act_window">
        <field name="name">App Banners</field>
        <field name="res_model">app.banner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="app_banner_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first banner</p>
            <p>
                Banners appear in the mobile app's Home carousel at a fixed
                3:1 aspect ratio. Upload images cropped to 3:1 for the
                cleanest look.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="app_banner_menu_root" name="App Banners"
              action="app_banner_action" sequence="100"/>

</odoo>
