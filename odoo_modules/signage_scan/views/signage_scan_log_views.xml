<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Scan History: the Odoo-side view of what the app shows under
         Manage → Scan History. Rows are written by /signage/lookup, so the list is
         read-only; clearing uses the normal multi-select delete, which the ACL
         already limits to base.group_system (the same gate the app's clear button
         goes through). -->

    <record id="signage_scan_log_list" model="ir.ui.view">
        <field name="name">signage.scan.log.list</field>
        <field name="model">signage.scan.log</field>
        <field name="arch" type="xml">
            <list string="Scan History" create="false" edit="false" sample="1"
                  decoration-danger="state == 'not_found'"
                  decoration-warning="state == 'disabled'">
                <field name="scan_date"/>
                <field name="barcode"/>
                <field name="product_name"/>
                <field name="product_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'found'"
                       decoration-danger="state == 'not_found'"
                       decoration-warning="state == 'disabled'"/>
                <field name="user_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="signage_scan_log_search" model="ir.ui.view">
        <field name="name">signage.scan.log.search</field>
        <field name="model">signage.scan.log</field>
        <field name="arch" type="xml">
            <search string="Scan History">
                <field name="barcode"/>
                <field name="product_name"/>
                <field name="user_id"/>
                <filter name="filter_not_found" string="Missing barcodes"
                        domain="[('state', '=', 'not_found')]"/>
                <filter name="filter_disabled" string="Off for scan"
                        domain="[('state', '=', 'disabled')]"/>
                <filter name="filter_found" string="Found"
                        domain="[('state', '=', 'found')]"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('scan_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <!-- Group By: Odoo 19's search RNG takes a bare <group>; expand/string
                     on it are rejected. -->
                <group>
                    <filter name="group_state" string="Result" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Scanned by" context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Scan Date" context="{'group_by': 'scan_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="signage_scan_log_action" model="ir.actions.act_window">
        <field name="name">Scan History</field>
        <field name="res_model">signage.scan.log</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="signage_scan_log_list"/>
        <field name="search_view_id" ref="signage_scan_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No scans yet</p>
            <p>Every barcode scanned from a terminal lands here. Use
               <b>Missing barcodes</b> to find codes that matched no product.</p>
        </field>
    </record>

    <menuitem id="signage_scan_log_menu" name="Scan History"
              parent="signage_menu_root"
              action="signage_scan_log_action" sequence="50"/>

</odoo>
