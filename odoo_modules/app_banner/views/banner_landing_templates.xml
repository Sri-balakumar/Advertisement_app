<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Public product-details page opened by /b/<access_code>.
         Deliberately self-contained (own inline CSS, no web.frontend_layout)
         so it renders fast on a phone after a QR scan and does not depend on
         the website/portal layout or its asset bundles. -->
    <template id="banner_landing_page" name="Banner Product Landing">
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title t-esc="product.display_name"/>
                <style>
                    * { box-sizing: border-box; }
                    body {
                        margin: 0;
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                        background: #f4f5f7;
                        color: #1f2937;
                        line-height: 1.5;
                    }
                    .wrap { max-width: 640px; margin: 0 auto; padding: 16px; }
                    .card {
                        background: #fff;
                        border-radius: 16px;
                        overflow: hidden;
                        box-shadow: 0 4px 20px rgba(0,0,0,.08);
                    }
                    .hero {
                        width: 100%;
                        aspect-ratio: 1 / 1;
                        object-fit: cover;
                        display: block;
                        background: #eef0f3;
                    }
                    .body { padding: 20px 22px 28px; }
                    h1 { font-size: 1.5rem; margin: 0 0 8px; }
                    .price { font-size: 1.6rem; font-weight: 700; color: #4338ca; margin: 6px 0 14px; }
                    .badge {
                        display: inline-block;
                        font-size: .8rem;
                        font-weight: 600;
                        padding: 4px 12px;
                        border-radius: 999px;
                    }
                    .badge.ok { background: #dcfce7; color: #166534; }
                    .badge.no { background: #e5e7eb; color: #4b5563; }
                    .desc { margin-top: 16px; color: #4b5563; white-space: pre-line; }
                    .foot { margin-top: 22px; font-size: .75rem; color: #9ca3af; text-align: center; }

                    /* Thank-you note after a successful enquiry (?sent=1). */
                    .thanks {
                        background: #dcfce7; color: #166534;
                        border-radius: 12px; padding: 12px 16px; margin: 0 0 16px;
                        font-weight: 600; font-size: .95rem;
                    }

                    /* Action buttons: PDF, WhatsApp, Call. */
                    .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
                    .btn {
                        display: inline-flex; align-items: center; justify-content: center;
                        gap: 6px; text-decoration: none; font-weight: 600; font-size: .95rem;
                        padding: 11px 18px; border-radius: 12px; border: 0; cursor: pointer;
                        flex: 1 1 auto; min-width: 120px; text-align: center;
                    }
                    .btn.pdf { background: #eef2ff; color: #4338ca; }
                    .btn.wa { background: #25d366; color: #fff; }
                    .btn.call { background: #1f2937; color: #fff; }
                    .btn.primary { background: #4338ca; color: #fff; width: 100%; }

                    /* CSS-only scroll-snap gallery — no JS. */
                    .gallery {
                        display: flex; gap: 10px; margin-top: 18px;
                        overflow-x: auto; scroll-snap-type: x mandatory;
                        -webkit-overflow-scrolling: touch; padding-bottom: 4px;
                    }
                    .gallery img {
                        scroll-snap-align: center; flex: 0 0 82%;
                        width: 82%; aspect-ratio: 1 / 1; object-fit: cover;
                        border-radius: 12px; background: #eef0f3;
                    }

                    /* Enquiry form. */
                    .enquiry { margin-top: 22px; border-top: 1px solid #e5e7eb; padding-top: 18px; }
                    .enquiry h2 { font-size: 1.1rem; margin: 0 0 12px; }
                    .enquiry label { display: block; font-size: .8rem; font-weight: 600; margin: 10px 0 4px; color: #374151; }
                    .enquiry input, .enquiry textarea {
                        width: 100%; padding: 11px 12px; border: 1px solid #d1d5db;
                        border-radius: 10px; font: inherit; color: #1f2937; background: #fff;
                    }
                    .enquiry textarea { min-height: 84px; resize: vertical; }
                    /* Off-screen honeypot: real users never see it, bots fill it. */
                    .hp { position: absolute; left: -9999px; top: -9999px; height: 0; width: 0; overflow: hidden; }
                </style>
            </head>
            <body>
                <div class="wrap">
                    <div class="card">
                        <img t-if="image_uri" t-att-src="image_uri" class="hero" alt="Product"/>
                        <div class="body">
                            <div t-if="sent" class="thanks">✅ Thanks! We’ve got your enquiry and will be in touch shortly.</div>
                            <h1 t-esc="product.name"/>
                            <div class="price">
                                <span t-esc="product.currency_id.symbol or ''"/>
                                <span t-esc="'%.2f' % (product.list_price or 0.0)"/>
                            </div>
                            <span t-if="product.sale_ok" class="badge ok">Available</span>
                            <span t-else="" class="badge no">Currently unavailable</span>
                            <div t-if="product.description_sale" class="desc"
                                 t-esc="product.description_sale"/>

                            <!-- Gallery (scroll-snap carousel). -->
                            <div t-if="gallery" class="gallery">
                                <img t-foreach="gallery" t-as="g" t-att-src="g" alt="Photo"/>
                            </div>

                            <!-- PDF + contact CTAs. -->
                            <div t-if="has_pdf or cta_digits" class="actions">
                                <a t-if="has_pdf" t-attf-href="/b/#{banner.access_code}/pdf"
                                   class="btn pdf">⬇ Download PDF</a>
                                <a t-if="cta_digits" t-attf-href="https://wa.me/#{cta_digits}"
                                   class="btn wa" target="_blank" rel="noopener">WhatsApp</a>
                                <a t-if="cta_digits" t-attf-href="tel:+#{cta_digits}"
                                   class="btn call">Call</a>
                            </div>

                            <!-- Enquiry form → POST /b/<code>/enquiry. -->
                            <div class="enquiry">
                                <h2>Interested? Send an enquiry</h2>
                                <form t-attf-action="/b/#{banner.access_code}/enquiry" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                                    <!-- Honeypot: hidden decoy field; a filled value = bot. -->
                                    <div class="hp" aria-hidden="true">
                                        <label for="company_website">Company website</label>
                                        <input type="text" id="company_website" name="company_website"
                                               tabindex="-1" autocomplete="off"/>
                                    </div>
                                    <label for="enq_name">Your name</label>
                                    <input type="text" id="enq_name" name="name" required="required"
                                           placeholder="Jane Doe"/>
                                    <label for="enq_phone">Phone</label>
                                    <input type="tel" id="enq_phone" name="phone" required="required"
                                           placeholder="+1 555 123 4567"/>
                                    <label for="enq_message">Message</label>
                                    <textarea id="enq_message" name="message"
                                              placeholder="I'd like to know more…"/>
                                    <div class="actions">
                                        <button type="submit" class="btn primary">Send enquiry</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="foot" t-esc="banner.name or ''"/>
                </div>
            </body>
        </html>
    </template>

    <!-- Friendly holding page shown when a scanned banner is archived or has
         no linked product yet — avoids a bare 404 for a real, scanned code. -->
    <template id="banner_unavailable_page" name="Banner Unavailable">
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Not available</title>
                <style>
                    * { box-sizing: border-box; }
                    body {
                        margin: 0;
                        min-height: 100vh;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                        background: #f4f5f7;
                        color: #1f2937;
                        line-height: 1.5;
                    }
                    .card {
                        background: #fff;
                        border-radius: 16px;
                        box-shadow: 0 4px 20px rgba(0,0,0,.08);
                        padding: 40px 28px;
                        margin: 16px;
                        max-width: 420px;
                        text-align: center;
                    }
                    .emoji { font-size: 3rem; line-height: 1; margin-bottom: 12px; }
                    h1 { font-size: 1.4rem; margin: 0 0 8px; }
                    p { color: #6b7280; margin: 0; }
                    .foot { margin-top: 18px; font-size: .75rem; color: #9ca3af; }
                </style>
            </head>
            <body>
                <div class="card">
                    <div class="emoji">🕓</div>
                    <h1>Not available right now</h1>
                    <p>This offer isn't live at the moment. Please check back soon.</p>
                    <div class="foot" t-esc="banner.name or ''"/>
                </div>
            </body>
        </html>
    </template>

</odoo>
