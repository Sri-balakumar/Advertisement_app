<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View (Odoo 19 uses <list>, not <tree>) -->
    <record id="app_banner_scan_list_view" model="ir.ui.view">
        <field name="name">app.banner.scan.list</field>
        <field name="model">app.banner.scan</field>
        <field name="arch" type="xml">
            <list string="Scans" create="0" edit="0">
                <field name="create_date" string="Scanned On"/>
                <field name="banner_id"/>
                <field name="country_name"/>
                <field name="country_code" optional="hide"/>
                <field name="ip_address"/>
                <field name="referrer" optional="hide"/>
                <field name="user_agent" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="app_banner_scan_action" model="ir.actions.act_window">
        <field name="name">Banner Scans</field>
        <field name="res_model">app.banner.scan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No scans yet</p>
            <p>Every time a customer scans a banner QR or opens its short link,
               a row appears here with when, where and which banner.</p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="app_banner_scan_menu" name="Scans"
              parent="app_banner_menu_root"
              action="app_banner_scan_action" sequence="20"/>

</odoo>
