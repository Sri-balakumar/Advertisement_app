{
  "expo": {
    "name": "369 Advertisement",
    "slug": "advertisement-369",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ads369",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EBF1FC",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-369-ad.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#EBF1FC",
          "dark": {
            "backgroundColor": "#EBF1FC"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow 369 Advertisement to use your photos to add ad images."
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow 369 to use the camera to scan product barcodes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
