{
  "expo": {
    "name": "NEXGENN PRICE CHECKER",
    "slug": "369-price-checker",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "pricechecker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alphalize.pricechecker369"
    },
    "android": {
      "package": "com.alphalize.pricechecker369",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EBF1FC",
          "dark": {
            "backgroundColor": "#EBF1FC"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NEXGENN PRICE CHECKER to use your photos to add ad images."
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NEXGENN PRICE CHECKER to use the camera to scan product barcodes."
        }
      ],
      "./plugins/with-pos-android"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7e1dab9-5533-4a98-9f63-35cf353dd461"
      }
    },
    "owner": "tawexi"
  }
}
