<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Products: the same catalogue the app's Manage → Products screen edits.
         Deliberately trimmed to the fields /signage/product/basic/get|save round-trips
         (see _product_vals in controllers/main.py) so an admin sees the same thing here
         and on the terminal. The full Odoo product form stays reachable from
         Inventory/Sales for everything else. -->

    <record id="signage_catalog_list" model="ir.ui.view">
        <field name="name">product.template.signage.catalog.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Products" sample="1">
                <field name="currency_id" column_invisible="True"/>
                <field name="cost_currency_id" column_invisible="True"/>
                <field name="product_variant_count" column_invisible="True"/>
                <field name="name"/>
                <field name="barcode" readonly="product_variant_count != 1"/>
                <field name="default_code" optional="show"/>
                <field name="categ_id" optional="show"/>
                <field name="list_price" string="Sales Price"
                       widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="standard_price" string="Cost" readonly="1" optional="hide"
                       widget="monetary" options="{'currency_field': 'cost_currency_id'}"/>
                <field name="signage_enabled" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="signage_catalog_kanban" model="ir.ui.view">
        <field name="name">product.template.signage.catalog.kanban</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="currency_id"/>
                <field name="signage_enabled"/>
                <templates>
                    <t t-name="card">
                        <div class="text-center mb-1">
                            <field name="image_128" widget="image" options="{'size': [140, 140]}"/>
                        </div>
                        <field name="name" class="fw-bold fs-6"/>
                        <div class="text-muted">
                            <field name="barcode"/>
                        </div>
                        <div class="mt-1">
                            <field name="list_price" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <span t-if="!record.signage_enabled.raw_value"
                                  class="badge text-bg-warning ms-1">Off for scan</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="signage_catalog_form" model="ir.ui.view">
        <field name="name">product.template.signage.catalog.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <field name="product_variant_count" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" string="Product Name"/>
                        <h1><field name="name" placeholder="e.g. Coca-Cola 330ml"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="barcode" readonly="product_variant_count &gt; 1"
                                   placeholder="Scanned by the price checker"/>
                            <field name="default_code" string="Internal Reference"/>
                            <field name="categ_id"/>
                            <field name="uom_id"/>
                        </group>
                        <group string="Pricing">
                            <field name="list_price" string="Sales Price"/>
                            <field name="standard_price" string="Cost"/>
                        </group>
                    </group>
                    <group string="Scan">
                        <field name="signage_enabled"/>
                        <field name="signage_show_image"/>
                    </group>
                    <group string="Description">
                        <field name="description_sale" nolabel="1"
                               placeholder="Shown on scan when the Description field is enabled."/>
                    </group>
                    <div class="text-muted">
                        <i class="fa fa-info-circle me-1"/>
                        Choose which of these fields appear when this barcode is scanned under
                        <b>Signage Scan → Scan Fields</b>.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="signage_catalog_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 1, 'view_mode': 'list', 'view_id': ref('signage_catalog_list')}),
            (0, 0, {'sequence': 2, 'view_mode': 'kanban', 'view_id': ref('signage_catalog_kanban')}),
            (0, 0, {'sequence': 3, 'view_mode': 'form', 'view_id': ref('signage_catalog_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a product</p>
            <p>Give it a name, a barcode and a price — that is all the price checker needs.</p>
        </field>
    </record>

    <menuitem id="signage_catalog_menu" name="Products"
              parent="signage_menu_root"
              action="signage_catalog_action" sequence="10"/>

</odoo>
