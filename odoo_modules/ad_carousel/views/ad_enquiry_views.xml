<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Leads submitted from the scanned product landing page. -->
    <record id="ad_enquiry_list" model="ir.ui.view">
        <field name="name">ad.enquiry.list</field>
        <field name="model">ad.enquiry</field>
        <field name="arch" type="xml">
            <list string="Enquiries">
                <field name="create_date" string="When"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="product_id"/>
                <field name="banner_id"/>
                <field name="handled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ad_enquiry_form" model="ir.ui.view">
        <field name="name">ad.enquiry.form</field>
        <field name="model">ad.enquiry</field>
        <field name="arch" type="xml">
            <form string="Enquiry">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="banner_id"/>
                        <field name="product_id"/>
                        <field name="handled"/>
                        <field name="create_date" readonly="1"/>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ad_enquiry_action" model="ir.actions.act_window">
        <field name="name">Enquiries</field>
        <field name="res_model">ad.enquiry</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="ad_enquiry_menu" name="Enquiries"
              parent="ad_carousel_menu_root"
              action="ad_enquiry_action" sequence="25"/>

</odoo>
